{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(docker compose up:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(npx prisma migrate reset:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  }
}
