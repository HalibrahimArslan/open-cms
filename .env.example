# =============================================================================
# CMS — ortam değişkenleri şablonu
# Kullanım:  cp .env.example .env   (kök dizinde; .env git'e GİRMEZ)
# Bu dosyada GERÇEK secret OLMAZ. Değerler yalnızca lokal geliştirme içindir.
# Docker Compose bu dosyayı kökteki compose.yaml üzerinden okur. Uygulamayı
# Docker dışında (host'ta `npm run dev`) çalıştırıyorsanız aynı değişkenleri
# backend/.env ve frontend/.env.local içine koyun (bkz. infra/README.md).
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# postgres container'ı ilk açılışta bu kullanıcı/şifre/veritabanını oluşturur.
# Not: volume oluştuktan sonra değiştirmek mevcut DB'yi DEĞİŞTİRMEZ.
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=cms
# Host'a açılan port. Makinenizde başka bir Postgres 5432'yi kullanıyorsa değiştirin.
POSTGRES_PORT=5432

# Prisma bağlantı adresi — backend'i HOST üzerinde çalıştırırken kullanılır
# (localhost). Docker içindeki backend için compose bunu otomatik olarak
# host=postgres ile üretir; buradaki değer container'a GEÇMEZ.
DATABASE_URL=postgresql://cms:change-me-local-db-password@localhost:5432/cms?schema=public

# --- Backend (Fastify) -------------------------------------------------------
# Backend'in dinlediği port (sözleşme: 4000).
BACKEND_PORT=4000
# JWT imzalama anahtarı. Zorunlu; boşsa `--profile app` başlamaz.
# Üretmek için: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Backend'in CORS ile izin vereceği origin (frontend adresi).
CORS_ORIGIN=http://localhost:3000
# Yüklenen medya dosyalarının yazılacağı dizin. Docker'da /app/uploads
# (named volume "uploads") sabittir; bu değer host'ta çalıştırma içindir.
UPLOAD_DIR=./uploads
# Tek dosya için azami yükleme boyutu (MB).
MAX_UPLOAD_SIZE_MB=10
# Seed script'inin oluşturacağı ilk admin kullanıcı (yalnızca lokal).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# --- Frontend (Next.js) ------------------------------------------------------
# Frontend'in dinlediği port (sözleşme: 3000).
FRONTEND_PORT=3000
# Tarayıcının çağıracağı API kök adresi. NEXT_PUBLIC_ önekli olduğu için
# client bundle'a gömülür — buraya secret KONMAZ.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
